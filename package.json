{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:e2e": "node tests/e2e/master-e2e.mjs",
    "test:resilience": "node tests/resilience/resilience.mjs",
    "test:providers": "node tests/providers/provider-coverage.mjs && node tests/providers/archive-honesty.mjs",
    "test:jamendo": "node tests/jamendo/flac-truth.mjs && node tests/jamendo/first-play-rate.mjs",
    "test:next-phase": "node tests/auth/redirect-uri.mjs && node tests/search/catalog-discovery.mjs",
    "test:all": "npm run test:e2e && npm run test:resilience && npm run test:providers && npm run test:jamendo && npm run test:next-phase",
    "test:fixtures": "node tests/fixtures/make-fixture.mjs"
  },
  "dependencies": {
    "@fontsource/material-symbols-outlined": "^5.3.8",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
