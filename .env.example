# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SPOTIFY_CLIENT_ID: Optional Spotify OAuth App Client ID
SPOTIFY_CLIENT_ID="5822fb3ce1814fc4916d228c580a8a0a"

# REDIRECT_URI: OAuth callback URI (must match Spotify Developer Dashboard exactly).
# For local development: http://127.0.0.1:3000/auth/spotify/callback
# Server-side (server.ts): REDIRECT_URI
# Client-side (vite): VITE_REDIRECT_URI
# REDIRECT_URI="http://127.0.0.1:3000/auth/spotify/callback"
# VITE_REDIRECT_URI="http://127.0.0.1:3000/auth/spotify/callback"

# VITE_JAMENDO_CLIENT_ID: Free Jamendo API client ID (devportal.jamendo.com, read-only plan).
# Enables the Jamendo free-catalogue provider (full tracks, up to FLAC).
# Can also be entered in the app under Settings -> Free catalogue (stored in the browser).
# This is a public client identifier, not a secret, but keep it out of committed docs.
# VITE_JAMENDO_CLIENT_ID=your_client_id_here

# SESSION_ENCRYPTION_KEY: 32+ char secret for the server-side Spotify session vault.
# Required in production; dev falls back to an ephemeral key (sessions lost on restart).
# SESSION_ENCRYPTION_KEY=""
